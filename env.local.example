# 로컬 개발용 환경 변수 설정 예시
# 이 파일을 복사해서 .env.local 파일을 만들고 실제 값들을 입력하세요

# 데이터베이스 설정
SPRING_DATABASE_URL=jdbc:mysql://localhost:3306/antwork_local?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
MYSQL_USERNAME=root
MYSQL_PASSWORD=password

# JWT 설정
JWT_SECRET=your-secret-key-here-for-local-development-only

# OAuth 설정
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# AWS S3 설정
S3_BUCKET_NAME=your-s3-bucket-name
S3_REGION=ap-northeast-2
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key

# Spring Profile
SPRING_PROFILES_ACTIVE=local 